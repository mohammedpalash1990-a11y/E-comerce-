# ---- API (Node 22+) ----
NODE_ENV=development
PORT=4000
WEB_PORT=3000
SQLITE_FILE=./data/marketplace.sqlite
# Comma-separated list of allowed browser origins (add your GitHub Pages / custom domain in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,https://mohammedpalash1990-a11y.github.io
SESSION_DAYS=7
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MAX=600
TRUST_PROXY=0
FREE_SHIPPING_OVER_BDT=0

# ---- Production only (NODE_ENV=production) ----
# First admin account (no demo accounts are created in production)
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Required in production: secret used to verify payment gateway callbacks
PAYMENT_WEBHOOK_SECRET=

# ---- Payment & courier ----
PAYMENT_MODE=sandbox        # sandbox | live (live needs real merchant credentials)
COURIER_MODE=sandbox
BKASH_APP_KEY=
NAGAD_MERCHANT_ID=
ROCKET_MERCHANT_ID=
SSLCOMMERZ_STORE_ID=
PATHAO_API_KEY=
STEADFAST_API_KEY=
REDX_API_KEY=

# ---- Planned (not used by runtime yet) ----
DATABASE_URL=postgresql://marketplace:change-me@localhost:5432/marketplace
