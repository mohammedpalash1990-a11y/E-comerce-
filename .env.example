NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WEB_PORT=3000
SQLITE_FILE=./data/marketplace.sqlite
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-before-deployment
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
# In production, replace with exact HTTPS frontend origins only.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret-before-deployment
# Required only for first-admin bootstrap when NODE_ENV=production.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Reserved for the future PostgreSQL adapter; the current API does not read DATABASE_URL.
# Do not set NODE_ENV=production until the PostgreSQL runtime adapter is implemented.
DATABASE_URL=
