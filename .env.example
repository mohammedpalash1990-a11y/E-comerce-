NODE_ENV=development
HOST=0.0.0.0
PORT=4000
WEB_PORT=3000
SQLITE_FILE=./data/marketplace.sqlite
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-before-deployment
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
# In production, replace with exact HTTPS frontend origins only.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret-before-deployment
# Required only for first-admin bootstrap when NODE_ENV=production.
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# PostgreSQL migration/bootstrap settings. These enable the migration command only;
# the complete API still has SQLite-backed customer/seller/admin route modules.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL_MODE=require
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_APPLICATION_NAME=bangladesh-marketplace-api

# Do not set NODE_ENV=production yet. API production startup remains deliberately blocked
# until every customer/seller/admin route has a PostgreSQL implementation and E2E coverage.
