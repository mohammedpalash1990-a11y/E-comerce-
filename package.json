{
  "name": "bangladesh-multivendor-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Bangladesh-focused multi-vendor marketplace MVP",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start:api": "node apps/api/src/server.mjs",
    "start:web": "node apps/web/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check apps/api/src/server.mjs && node --check apps/api/src/server.modular.mjs && node --check apps/web/server.mjs && node --check scripts/dev.mjs && node scripts/check.mjs && npm test",
    "start:api:modular": "node apps/api/src/server.modular.mjs"
  }
}
